print_step "5. Host Discovery (K8s + AWS Credentials)"
echo -e "\n${CYAN}🔧 Tools: ssh, curl, jq${NC}"
echo -e "\n${CYAN}Real commands:${NC}"
echo "  ssh -p 2223 deploy@localhost 'cat ~/.aws/credentials'"
echo "  ssh -p 2223 deploy@localhost 'cat /opt/deploy/kubeconfig'"
echo "  curl -k -H \"Bearer neaUPVW4...GhMv\" https://localhost:6443/api/v1/namespaces"
echo -e "\n${CYAN}Simulated output:${NC}"
echo -e "\n${CYAN}AWS credentials:${NC}"
echo -e "  [default]"
echo -e "  aws_access_key_id = AKIA3E...NCD5"
echo -e "  aws_secret_access_key = xoS63WIqPhR61HSDCa3A0s1KxHiN6f4gcZTNBPBP"
echo -e "  region = ap-southeast-1"
echo -e "\n${CYAN}K8s kubeconfig:${NC}"
echo -e "  apiVersion: v1"
echo -e "  kind: Config"
echo -e "  clusters:"
echo -e "  - name: hal-prod"
echo -e "    cluster:"
echo -e "      server: https://k8s.harborline-logistics.internal:6443"
echo -e "      insecure-skip-tls-verify: true"
echo -e "  users:"
echo -e "  - name: deploy-reader"
echo -e "    user:"
echo -e "      token: neaUPVW4RYGJViL9C8iUHxNtr8HULVBeiJKsY0Eg9Lq9GhMv"
echo -e "\n${CYAN}K8s API — namespaces:${NC}"
echo -e "  default, kube-system, ci, payments"
echo -e "\n${CYAN}K8s API — pods:${NC}"
echo -e "  hal-frontend-7f9b8c-x4y2z (node-01)"
echo -e "  hal-api-5c8d7e-9a1b2 (node-01)"
echo -e "  hal-worker-6b9f1a-k3m4n (node-02)"
print_trap "The SSH decoy simulated the login — the shell is a Go-written emulator, not a real shell. When you run 'cat ~/.aws/credentials', you get the planted AWS credentials. These look real, but they're planted honeytoken credentials — they only 'work' inside the simulated environment. The decoy also serves a fake /opt/deploy/kubeconfig with a bearer token."
print_evidence "SSH login successful. Fake AWS credentials: AKIA3E...NCD5 + xoS63WIqPhR61HSDCa3A0s1KxHiN6f4gcZTNBPBP. K8s bearer token: neaUPVW4...GhMv. K8s API returns 4 namespaces + 3 fake pods."
print_soc "auth.attempt (password), shell.command, token.used (SSH key), k8s.api_call, token.used (kubeconfig)"
print_next "Beacon trigger"

# Step 6
print_step "6. Beacon / Honeytoken Trigger (AWS Key)"
echo -e "\n${CYAN}🔧 Tools: curl${NC}"
echo -e "\n${CYAN}Real commands:${NC}"
echo "  curl http://localhost:8088/t/tok_url"
echo "  curl -s -H \"Authorization: AWS4-HMAC-SHA256 ***\" -H \"x-amz-date: 20261031T120000Z\" http://localhost:8088/backup/data"
echo -e "\n${CYAN}Simulated output:${NC}"
echo -e "\n${CYAN}Triggering URL token:${NC}"
echo -e "  HTTP 200 OK (1x1 pixel)"
echo -e "  Token.used: tok_url (sensitivity 2)"
echo -e "\n${CYAN}Triggering AWS key:${NC}"
echo -e "  HTTP 200 OK"
echo -e "  Token.used: tok_aws_k7 (sensitivity 5)"
echo -e "  Risk jump: 5 → 90 (CRITICAL)"
print_trap "The beacon is a honeytoken endpoint — designed to be triggered. Triggering it emits token.used with sensitivity 5, jumping your risk to CRITICAL. The SOC merges your SSH session and K8s session into one actor (credential lineage). An incident opens and is alerted to Discord/Slack."
print_evidence "Beacon token triggered with AWS honeytoken key: AKIA3E...NCD5"
print_soc "token.used (sensitivity 5), CRITICAL incident opened, alert dispatched to Discord/Slack"
print_next "Dashboard verification"

# Step 7
print_step "7. Dashboard Verification"
echo -e "\n${CYAN}🔧 Tools: curl, jq${NC}"
echo -e "\n${CYAN}Real commands:${NC}"
echo "  curl http://localhost:8090/v1/stats/overview | jq"
echo "  curl http://localhost:8090/v1/honeytokens | jq"
echo "  curl http://localhost:8090/v1/actors | jq"
echo -e "\n${CYAN}Simulated dashboard data:${NC}"
echo -e "\n${CYAN}Stats overview:${NC}"
echo -e "  Active actors:     16"
echo -e "  Events:            189"
echo -e "  Open incidents:    critical: 2, high: 0, medium: 0, low: 0"
echo -e "\n${CYAN}Honeytoken hits:${NC}"
echo -e "  tok_aws_k7:      1 hit"
echo -e "  tok_kube:        2 hits"
echo -e "  tok_url:         1 hit"
echo -e "  tok_backup_key:  1 hit"
echo -e "\n${CYAN}Actors (linked via credential lineage):${NC}"
