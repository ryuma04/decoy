echo -e "\n${RED}"
echo "╔══════════════════════════════════════════════════════════════╗"
echo "║   ATTACK COMPLETE — You are caught                        ║"
echo "║   All credentials are simulated.                            ║"
echo "║   SOC records: auth.attempt, shell.command, token.used      ║"
echo "╚══════════════════════════════════════════════════════════════╝"
