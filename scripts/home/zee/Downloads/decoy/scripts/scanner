echo -e "  HTTP 200 OK (12542 bytes)"
echo -e "  Extracted: deploy_id_ed25519 (SSH private key)"
echo -e "\n${CYAN}Fetching fake .env...${NC}"
echo -e "  HTTP 200 OK"
echo -e "  Content:"
echo -e "    APP_NAME=AdminPortal"
echo -e "    APP_ENV=production"
echo -e "    APP_KEY=base64:Q6x9pB2vR8mYcD4fL1hJ3kM5nQ7wZ0tA=/  "
echo -e "    DB_HOST=db.harborline-logistics.internal"
echo -e "    DB_PORT=5432"
echo -e "    DB_USER=app"
echo -e "    DB_PASSWORD=zsigUSlUduZQfNuf8L"
