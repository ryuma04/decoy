#!/usr/bin/env bash
# ============================================================================
# scripts/scanner — Admin subdomain attack demonstration (simulated)
# ============================================================================
# Usage:
#   scripts/scanner https://aeteesadmin.aeteesbakehouse.com
# ============================================================================

set -euo pipefail

ADMIN_URL="${1:-https://aeteesadmin.aeteesbakehouse.com}"
ADMIN_HOST="$(echo "$ADMIN_URL" | sed -E 's|^https?://||; s|/.*$||')"
LOG_DIR="/home/zee/Downloads/decoy/.logs/attack-demo"
mkdir -p "${LOG_DIR}"

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
BLUE=$'\033[0;34m'
CYAN=$'\033[0;36m'
NC=$'\033[0m'

print_step() {
  echo -e "\n${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
  echo -e "${BLUE}  STEP: $1${NC}"
  echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
}

print_trap() {
  echo -e "\n${RED}🕳️  WHERE YOU FALL INTO THE TRAP:${NC}"
  echo -e "${RED}  $1${NC}"
}

print_evidence() {
  echo -e "\n${GREEN}📋 EVIDENCE (what you got):${NC}"
  echo -e "${GREEN}  $1${NC}"
}

print_soc() {
  echo -e "\n${YELLOW}📊 SOC RECORDED:${NC}"
  echo -e "${YELLOW}  $1${NC}"
}

print_next() {
  echo -e "\n${CYAN}➡️  NEXT STEP:${NC}"
  echo -e "  ${CYAN} $1${NC}"
}

echo -e "${CYAN}"
echo "╔══════════════════════════════════════════════════════════════╗"
echo "║   Deception SOC Lab — Admin Subdomain Attack Demo           ║"
echo "║   Target: ${ADMIN_URL}                                  ║"
echo "╚══════════════════════════════════════════════════════════════╝"
echo -e "${NC}"

# Step 1
print_step "1. Port Sweep (Reconnaissance)"
echo -e "\n${CYAN}🔧 Tools: nmap, ss${NC}"
echo -e "\n${CYAN}Real scan (simulated output):${NC}"
echo -e "\n$ nmap -sT -Pn -p 2223,8081,8088,6443 ${ADMIN_HOST}"
echo -e "Starting Nmap 7.92 ( https://nmap.org ) at 2026-11-01 08:25 +0530"
echo -e "Nmap scan report for ${ADMIN_HOST}"
echo -e "Host is up (0.001s latency)."
echo -e "Not shown: 4 closed ports"
echo -e "PORT     STATE         SERVICE"
echo -e "2222/tcp open          ssh"
echo -e "8080/tcp open         http"
echo -e "8088/tcp open         unknown"
echo -e "6443/tcp open         kubernetes-api"
echo -e "Nmap scan complete: 4 IP addresses (1 host up) scanned in 0.42 seconds"

echo -e "\n${CYAN}Also check: ss -tlnp | grep -E ':(2223|8081|8088|6443):${NC}"
echo -e "LISTEN 0 4096 0.0.0.0:2223 0.0.0.0:* users:((\"decoy-ssh.ex\",pid=1789828,fd=7))"
echo -e "LISTEN 0 4096 0.0.0.0:8081 0.0.0.0:* users:((\"decoy-web.exe\",pid=1789831,fd=7))"
echo -e "LISTEN 0 4096 0.0.0.0:8088 0.0.0.0:* users:((\"decoy-beacon.exe\",pid=1789839,fd=7))"
echo -e "LISTEN 0 4096 0.0.0.0:6443 0.0.0.0:* users:((\"decoy-k8s.exe\",pid=1789844,fd=7))"

print_trap "You see 4 decoy services (SSH:2223, Web:8081, Beacon:8088, K8s:6443) on your own machine. They're indistinguishable from real infrastructure. Decoys add 30–150ms random latency, so timing looks real."
print_evidence "Port scan shows 4 open services. You're scanning your own machine, not a remote server."
print_soc "port_sweep rule → T1046 (Network Service Scanning), low risk"
print_next "Web reconnaissance — gobuster + curl"

# Step 2
print_step "2. Gobuster Directory Brute-Force (honeypot discovery)"
echo -e "\n${CYAN}🔧 Tools: gobuster, curl${NC}"
echo -e "\n${CYAN}Real command:${NC}"
echo "  gobuster dir -u ${ADMIN_URL} -w /usr/share/wordlists/dirbuster/directory-list-2.3-medium.txt -t 10"
echo ""
echo -e "${CYAN}Simulated output:${NC}"
echo -e "\n===============================================================Gobuster v3.8.2by OJ Reeves (@TheColonial) & Christian Mehlmauer (@firefart)===============================================================[+] Url:                     https://aeteesadmin.aeteesbakehouse.com[+] Method:                  GET[+] Threads:                 10[+] Wordlist:                directory-list-2.3-medium.txt[+] Status codes:            200, 204, 301, 302, 307, 401, 403, 500[+] User Agent:              gobuster/3.8.2[+] Timeout:                 10s===============================================================[2026/11/01 08:23:47] [INFO] Scanning URL: https://aeteesadmin.aeteesbakehouse.com[2026/11/01 08:23:48] [INFO] Method: GET, Threads: 10[2026/11/01 08:23:49] [INFO] Wordlist: directory-list-2.3-medium.txt[2026/11/01 08:23:50] [INFO] Status codes: 200,204,301,302,307,401,403,500[2026/11/01 08:23:50] [INFO] Discovered files:/etc              Status: 301        Link: https://aeteesadmin.aeteesbakehouse.com/etc/admin             Status: 200        Link: https://aeteesadmin.aeteesbakehouse.com/admin/admin/backup      Status: 200        Link: https://aeteesadmin.aeteesbakehouse.com/admin/backup/.env              Status: 200        Link: https://aeteesadmin.aeteesbakehouse.com/.env/robots.txt        Status: 200        Link: https://aeteesadmin.aeteesbakehouse.com/robots.txt/api               Status: 200        Link: https://aeteesadmin.aeteesbakehouse.com/api/api/login          Status: 200        Link: https://aeteesadmin.aeteesbakehouse.com/api/login/logout            Status: 200        Link: https://aeteesadmin.aeteesbakehouse.com/logout===============================================================[2026/11/01 08:23:50] [INFO] 202239 files scanned in 9.221545s (2194.67 files/sec)[2026/11/01 08:23:50] [INFO] Discovered files:/admin/backup[2026/11/01 08:23:50] [INFO]   /.env[2026/11/01 08:23:50] [INFO]   /api[2026/11/01 08:23:50] [INFO]   /api/login[2026/11/01 08:23:50] [INFO]   /admin[2026/11/01 08:23:50] [INFO]   /robots.txt[2026/11/01 08:23:50] [INFO]   /logoutecho -e "\n${CYAN}Saving results for review:${NC}"echo -e "  Results saved to: ${LOG_DIR}/${ADMIN_HOST}.txt"print_trap "The attacker sees /admin/backup, /.env, /api/login as real, sensitive paths. But these are decoys: the backup portal contains a planted SSH key, /.env is a simulated environment file, and /api/login is a fake endpoint."print_evidence "gobuster found: /admin, /admin/backup, .env, /robots.txt, /api, /api/login, /logout all HTTP 200"print_soc "http.request events (web decoy inventory)"print_next "Download honeyfiles — curl"

