#!/usr/bin/env bash
# ============================================================================
# scripts/scanner - Admin subdomain attack demonstration (simulated)
# ============================================================================
# Usage:
#   scripts/scanner https://aeteesadmin.aeteesbakehouse.com
# ============================================================================

set -euo pipefail

ADMIN_URL="${1:-https://aeteesadmin.aeteesbakehouse.com}"
ADMIN_HOST="$(echo "$ADMIN_URL" | sed -E 's|^https?://||; s|/.*$||')"
LOG_DIR="/home/zee/Downloads/decoy/.logs/attack-demo"
mkdir -p "${LOG_DIR}"

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
BLUE=$'\033[0;34m'
CYAN=$'\033[0;36m'
NC=$'\033[0m'

print_step() {
  echo -e "\n${BLUE}━━━━━━━━━━━━
  STEP: $1${NC}"
  echo -e "${BLUE}━━━━━━━━━━━━
  STEP: $1${NC}"
  echo -e "${BLUE}━━━━━━━━━━━━
  STEP: $1${NC}"
}

print_trap() {
  echo -e "\n${RED}WHERE YOU FALL INTO THE TRAP:${NC}"
  echo -e "${RED}  $1${NC}"
}

print_evidence() {
  echo -e "\n${GREEN}EVIDENCE (what you got):${NC}"
  echo -e "${GREEN}  $1${NC}"
}

print_soc() {
  echo -e "\n${YELLOW}SOC RECORDED:${NC}"
  echo -e "${YELLOW}  $1${NC}"
}

print_next() {
  echo -e "\n${CYAN}NEXT STEP:${NC}"
  echo -e "  ${CYAN} $1${NC}"
}

echo -e "${CYAN}"
echo "============================================="
echo "  Deception SOC Lab - Admin Subdomain Demo"
echo "  Target: ${ADMIN_URL}"
echo "============================================="
echo -e "${NC}"

# Step 1
print_step "1. Port Sweep (Reconnaissance)"
echo -e "\n${CYAN}[1/7] Port Sweep${NC}"
echo -e "\n$ nmap -sT -Pn -p 2223,8081,8088,6443 ${ADMIN_HOST}"
echo -e "2222/tcp open  ssh"
echo -e "8080/tcp open  http"
echo -e "8088/tcp open  unknown"
echo -e "6443/tcp open  kubernetes-api"

print_trap "You see 4 decoy services (SSH:2223, Web:8081, Beacon:8088, K8s:6443) on your own machine. They're indistinguishable from real infrastructure."
print_evidence "Port scan shows 4 open services on your own machine."
print_soc "port_sweep rule -> T1046, low risk"
print_next "Web recon - gobuster + curl"

# Step 2
print_step "2. Gobuster Directory Brute-Force"
echo -e "\n${CYAN}[2/7] Gobuster${NC}"
echo -e "\n$ gobuster dir -u ${ADMIN_URL} -w /usr/share/wordlists/dirbuster/directory-list-2.3-medium.txt -t 10"
echo -e "==================================================="
echo -e "Gobuster v3.8.2 by OJ Reeves & Christian Mehlmauer"
echo -e "[+] Url:                     https://aeteesadmin.aeteesbakehouse.com"
echo -e "[+] Method:                  GET"
echo -e "[+] Threads:                 10"
echo -e "[+] Wordlist:                directory-list-2.3-medium.txt"
echo -e "[+] Status codes:            200, 204, 301, 302, 307, 401, 403, 500"
echo -e "[+] User Agent:              gobuster/3.8.2"
echo -e "[+] Timeout:                 10s"
echo -e "==================================================="
echo -e "[2026/11/01 08:23:47] [INFO] Scanning URL: https://aeteesadmin.aeteesbakehouse.com"
echo -e "[2026/11/01 08:23:48] [INFO] Method: GET, Threads: 10"
echo -e "[2026/11/01 08:23:49] [INFO] Wordlist: directory-list-2.3-medium.txt"
echo -e "[2026/11/01 08:23:50] [INFO] Status codes: 200,204,301,302,307,401,403,500"
echo -e "[2026/11/01 08:23:50] [INFO] Discovered files:"
echo -e "/admin              Status: 200        Link: https://aeteesadmin.aeteesbakehouse.com/admin"
echo -e "/admin/backup       Status: 200        Link: https://aeteesadmin.aeteesbakehouse.com/admin/backup"
echo -e "/.env               Status: 200        Link: https://aeteesadmin.aeteesbakehouse.com/.env"
echo -e "/robots.txt         Status: 200        Link: https://aeteesadmin.aeteesbakehouse.com/robots.txt"
echo -e "/api                Status: 200        Link: https://aeteesadmin.aeteesbakehouse.com/api"
echo -e "/api/login          Status: 200        Link: https://aeteesadmin.aeteesbakehouse.com/api/login"
echo -e "/logout             Status: 200        Link: https://aeteesadmin.aeteesbakehouse.com/logout"
echo -e "==================================================="
echo -e "[2026/11/01 08:23:50] [INFO] 202239 files scanned in 9.221545s"
echo -e "[2026/11/01 08:23:50] [INFO] Discovered files:"
echo -e "/admin/backup"
echo -e "  /.env"
echo -e "  /api"
echo -e "  /api/login"
echo -e "  /admin"
echo -e "  /robots.txt"
echo -e "  /logout"

print_trap "The attacker sees /admin/backup, /.env, /api/login as real sensitive paths. But these are decoys: the backup portal contains a planted SSH key, /.env is a simulated environment file, and /api/login is a fake endpoint."
print_evidence "gobuster found: /admin, /admin/backup, .env, /robots.txt, /api, /api/login, /logout all HTTP 200"
print_soc "http.request events (web decoy inventory)"
print_next "Download honeyfiles - curl"

# Step 3
print_step "3. Download Honeyfiles"
echo -e "\n${CYAN}[3/7] Honeyfiles${NC}"
echo -e "\n$ curl -s ${ADMIN_URL}/admin/backup/internal-backup.zip -o /tmp/backup.zip"
echo -e "$ unzip -p /tmp/backup.zip deploy_id_ed25519 > /tmp/deploy_key"
echo -e "$ curl -s ${ADMIN_URL}/.env -o /tmp/env.txt"
echo -e "\n[Simulated output:]"
echo -e "\nDownloading internal-backup.zip..."
echo -e "  HTTP 200 OK (12542 bytes)"
echo -e "  Extracted: deploy_id_ed25519 (SSH private key)"
echo -e "\nFetching fake .env..."
echo -e "  HTTP 200 OK"
echo -e "  Content:"
echo -e "    APP_NAME=AdminPortal"
echo -e "    APP_ENV=production"
echo -e "    APP_KEY=base64:Q6x9pB2vR8mYcD4fL1hJ3kM5nQ7wZ0tA=/  "
echo -e "    DB_HOST=db.harborline-logistics.internal"
echo -e "    DB_PORT=5432"
echo -e "    DB_USER=app"
echo -e "    DB_PASSWORD=zsigUSlUduZQfNuf8L"

print_trap "The attacker downloads a fake backup ZIP containing a decoy SSH key. The SSH key looks real, but it's a decoys-only key that works for simulation only. The /.env file is a simulated environment file with fictional credentials."
print_evidence "Downloaded internal-backup.zip (contains decoy SSH key), .env (fake DB credentials)"
print_soc "file.download (internal-backup.zip), file.read (/.env)"
print_next "SSH login - sshpass + ssh"

# Step 4
print_step "4. SSH Key Extraction & Login"
echo -e "\n${CYAN}[4/7] SSH Login${NC}"
echo -e "\n$ ssh -i /tmp/deploy_key -p 2223 deploy@localhost 'whoami; pwd; uname -a'"
echo -e "\n[Simulated output:]"
echo -e "\nSSH login successful:"
echo -e "  deploy@hal-app-01:~$ whoami"
echo -e "  deploy"
echo -e "  deploy@hal-app-01:~$ pwd"
echo -e "  /home/deploy"
echo -e "  deploy@hal-app-01:~$ uname -a"
echo -e "  Linux hal-app-01 5.15.0-108-generic #90-Ubuntu SMP x86_64 x86_64 x86_64 GNU/Linux"
echo -e "\nKey details:"
echo -e "  Fingerprint: SHA256:2TiXkeO9WWFpKw7S93rN9CNtG4AvWDO8uzKTlkqXEP7"
echo -e "  Key type: ed25519 (decoy-accepted)"

print_trap "The SSH private key is planted in the honeypot's backup portal. The decoy's SSH server accepts it for simulation only. Once you use this key to SSH in, you're linked to the attacker actor via credential lineage."
print_evidence "Deploy SSH private key extracted from internal-backup.zip. Fingerprint: SHA256:2TiXkeO9WWFpKw7S93rN9CNtG4AvWDO8uzKTlkqXEP7"
print_soc "file.download (internal-backup.zip), token.used (SSH key), credential_lineage"
print_next "SSH login - sshpass + ssh"

# Step 5
print_step "5. Host Discovery (K8s + AWS)"
echo -e "\n${CYAN}[5/7] Host Discovery${NC}"
echo -e "\n$ ssh -p 2223 deploy@localhost 'cat ~/.aws/credentials'"
echo -e "$ ssh -p 2223 deploy@localhost 'cat /opt/deploy/kubeconfig'"
echo -e "$ curl -k -H "Bearer neaUPVW4...GhMv" https://localhost:6443/api/v1/namespaces"
echo -e "\n[Simulated output:]"
echo -e "\nAWS credentials:"
echo -e "  [default]"
echo -e "  aws_access_key_id = AKIA3E...NCD5"
echo -e "  aws_secret_access_key = xoS63WIqPhR61HSDCa3A0s1KxHiN6f4gcZTNBPBP"
echo -e "  region = ap-southeast-1"
echo -e "\nK8s kubeconfig:"
echo -e "  apiVersion: v1"
echo -e "  kind: Config"
echo -e "  users:"
echo -e "  - name: deploy-reader"
echo -e "    user:"
echo -e "      token: neaUPVW4RYGJViL9C8iUHxNtr8HULVBeiJKsY0Eg9Lq9GhMv"
echo -e "\nK8s API - namespaces:"
echo -e "  default, kube-system, ci, payments"
echo -e "\nK8s API - pods:"
echo -e "  hal-frontend-7f9b8c-x4y2z (node-01)"
echo -e "  hal-api-5c8d7e-9a1b2 (node-01)"
echo -e "  hal-worker-6b9f1a-k3m4n (node-02)"

print_trap "The SSH decoy simulated the login - the shell is a Go-written emulator, not a real shell. When you run 'cat ~/.aws/credentials', you get the planted AWS credentials. These look real, but they're planted honeytoken credentials - they only 'work' inside the simulated environment."
print_evidence "SSH login successful. Fake AWS credentials: AKIA3E...NCD5 + xoS63WIqPhR61HSDCa3A0s1KxHiN6f4gcZTNBPBP. K8s bearer token: neaUPVW4...GhMv. K8s API returns 4 namespaces + 3 fake pods."
print_soc "auth.attempt (password), shell.command, token.used (SSH key), k8s.api_call, token.used (kubeconfig)"
print_next "Beacon trigger"

# Step 6
print_step "6. Beacon / Honeytoken Trigger"
echo -e "\n${CYAN}[6/7] Beacon${NC}"
echo -e "\n$ curl http://localhost:8088/t/tok_url"
echo -e "$ curl -s -H "Authorization: AWS4-HMAC-SHA256 ***" -H "x-amz-date: 20261031T120000Z" http://localhost:8088/backup/data"
echo -e "\n[Simulated output:]"
echo -e "\nTriggering URL token:"
echo -e "  HTTP 200 OK (1x1 pixel)"
echo -e "  Token.used: tok_url (sensitivity 2)"
echo -e "\nTriggering AWS key:"
echo -e "  HTTP 200 OK"
echo -e "  Token.used: tok_aws_k7 (sensitivity 5)"
echo -e "  Risk jump: 5 -> 90 (CRITICAL)"

print_trap "The beacon is a honeytoken endpoint - designed to be triggered. Triggering it emits token.used with sensitivity 5, jumping your risk to CRITICAL. The SOC merges your SSH session and K8s session into one actor (credential lineage). An incident opens and is alerted to Discord/Slack."
print_evidence "Beacon token triggered with AWS honeytoken key: AKIA3E...NCD5"
print_soc "token.used (sensitivity 5), CRITICAL incident opened, alert dispatched to Discord/Slack"
print_next "Dashboard verification"

# Step 7
print_step "7. Dashboard Verification"
echo -e "\n${CYAN}[7/7] Dashboard${NC}"
echo -e "\n$ curl http://localhost:8090/v1/stats/overview | jq"
echo -e "$ curl http://localhost:8090/v1/honeytokens | jq"
echo -e "$ curl http://localhost:8090/v1/actors | jq"
echo -e "\n[Simulated dashboard data:]"
echo -e "\nStats overview:"
echo -e "  Active actors:     16"
echo -e "  Events:            189"
echo -e "  Open incidents:    critical: 2, high: 0, medium: 0, low: 0"
echo -e "\nHoneytoken hits:"
echo -e "  tok_aws_k7:      1 hit"
echo -e "  tok_kube:        2 hits"
echo -e "  tok_url:         1 hit"
echo -e "  tok_backup_key:  1 hit"
echo -e "\nActors (linked via credential lineage):"
echo -e "  ACT-0012: Risk 90, CRITICAL, services: [beacon, ssh]"
echo -e "  ACT-0011: Risk 85, CRITICAL, services: [k8s]"
echo -e "  ACT-0003: Risk 6, LOW, services: [web]"
echo -e "  ACT-0004: Risk 5, LOW, services: [web]"

print_trap "The SOC has linked all your attacks (web, SSH, K8s, beacon) into one actor. You're CRITICAL (risk >= 90). An incident is open. The alert went to Discord/Slack. You can't escape - the decoys are designed to be undetectable and to never expose anything real."
print_evidence "Dashboard shows: events, actors, incidents, token_hits, risk scores, severity levels"
print_soc "189 events, 16 active actors, 2 critical incidents, 15 token hits"

# Summary
echo -e "\n${RED}"
echo "============================================="
echo "  ATTACK COMPLETE - You are caught"
echo "  All credentials are simulated."
echo -e "  SOC records: auth.attempt, shell.command, token.used"
echo "============================================="
echo -e "${NC}"

exit 0
