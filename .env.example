# Copy to .env and fill in. .env is gitignored.
# Database: a Neon (or any Postgres) URL. Leave empty and use `--profile localdb` for Postgres in Docker.
DATABASE_URL=
PG_PASSWORD=change-me

JWT_SECRET=                     # >= 32 bytes: openssl rand -hex 32
SOC_ADMIN_EMAIL=admin@soc.local
SOC_ADMIN_PASSWORD=

# One HMAC key per sensor: openssl rand -hex 32
KEY_SSH=
KEY_WEB=
KEY_K8S=
KEY_BEACON=
KEY_LOGS=
KEY_DB=
KEY_AETEES=
SENSOR_KEYS=ssh-01:${KEY_SSH},web-01:${KEY_WEB},k8s-01:${KEY_K8S},beacon-01:${KEY_BEACON},logs-01:${KEY_LOGS},db-01:${KEY_DB},aetees-01:${KEY_AETEES}

# LLM narration (10 §N). Empty key = template text only.
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
NARRATE_MAX_PER_HOUR=120

DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
DASHBOARD_URL=http://localhost:3000
PERSONA_SEED=
MAZE_ADAPTIVE=true
SCORER_LEARN=false

# ---- Per-host ports (change when another service already uses the default) ----
DASHBOARD_PORT=3000
ML_PORT=8000
SSH_DECOY_PORT=2222
WEB_DECOY_PORT=8080
DB_DECOY_PORT=5433

# ---- Divert proxy in front of a live shop (docs/20) ----
# AETEES_SRC: shop source the clone is built from (its .env, *.sql, cookies.txt are never copied).
# AETEES_REAL_URL set: the proxy forwards to that live shop and aetees-lab.sh starts only the clone (:3101).
AETEES_SRC=
AETEES_REAL_URL=
PROXY_LISTEN=:8200          # 127.0.0.1:8200 when only cloudflared should reach it
TRUST_CLOUDFLARE=0          # 1: take the visitor IP from CF-Connecting-IP (only from a loopback peer)
DIVERT_MODE=shadow          # shadow: detect + report "would divert", divert nobody; live: divert
ADMIN_HONEYPOT_HOSTS=       # always live, e.g. aeteesadmin.aeteesbakehouse.com
